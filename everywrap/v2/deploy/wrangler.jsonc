{
  // The Worker that serves the site from the R2 bucket. Deploy with: npx wrangler deploy (from this folder).
  "name": "everywrap-v2",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // Where the booking form sends requests. The copy address is the secret LEAD_CC, set on the Worker and kept out of the repo.
  "vars": { "LEAD_TO": "sales@everywrap.com" },
  "r2_buckets": [{ "binding": "SITE", "bucket_name": "everywrap-site" }]
}
