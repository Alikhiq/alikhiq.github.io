{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/owner", "destination": "/owner.html" },
    { "source": "/owner/:path*", "destination": "/owner.html" },
    { "source": "/q", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/owner(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
